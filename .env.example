# ─────────────────────────────────────────────────────────────────────────────
# AurPay — environment variables (ALL OPTIONAL — the app runs with none set)
# ─────────────────────────────────────────────────────────────────────────────
# Without any keys the AI agent automatically falls back to a built-in
# deterministic Arabic intent engine, so every feature still works.
# With Groq keys you get the full LLM agent (chat + tools + voice).

# ── Groq (recommended) ───────────────────────────────────────────────────────
# Get free keys: https://console.groq.com/keys
# Up to 5 keys are pooled and auto-rotated on rate limits (429):
# when one key hits its limit it cools down ~1 min and the next key serves
# the request instantly — the user never waits.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
# (alternative) comma-separated list instead of numbered slots:
# GROQ_API_KEYS=key1,key2,key3

# Agent model (default: openai/gpt-oss-120b)
URPAY_AGENT_MODEL=openai/gpt-oss-120b
# Voice-to-text model (default: whisper-large-v3)
URPAY_ASR_MODEL=whisper-large-v3
# Groq-compatible base URL (default: https://api.groq.com/openai/v1)
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Optional internals (safe defaults — rarely changed) ──────────────────────
# Shared secret between the agent engine and the /api/internal/* bridge routes
URPAY_BRIDGE_SECRET=urpay-bridge-secret
# Point the LLM bridge at a remote helper instead of the local one
# (only useful for custom self-hosted setups)
# URPAY_LLM_BRIDGE=http://127.0.0.1:3000/api/internal/llm
