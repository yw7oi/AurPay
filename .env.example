# ─────────────────────────────────────────────────────────────────────────────
# AurPay — environment variables (ALL OPTIONAL — the app runs with none set)
# ─────────────────────────────────────────────────────────────────────────────
# Without any keys the AI agent automatically falls back to a built-in
# deterministic Arabic intent engine, so every feature still works.
# With Groq keys you get the full LLM agent (chat + tools + voice).

# ── Persistent database (STRONGLY recommended on Vercel) ─────────────────────
# WITHOUT it every serverless instance keeps its own memory: new accounts and
# transfers VANISH when the instance recycles, logins bounce back to the home
# screen, and confirmations answer "not found". WITH a store, all instances
# share ONE database and every account / transfer / transaction survives.
#
# OPTION A — Vercel Blob (EASIEST: ~4 clicks, everything inside Vercel):
#   1) Vercel dashboard → your project → Storage tab
#   2) Create → Blob → choose access (Private recommended) → Create
#   3) Connect the store to THIS project (env vars attach automatically)
#   4) Deployments → ⋯ → Redeploy
#   No tokens to copy, no external site. Verify: GET /api/health
#   → "db": { "mode": "blob" }. (BLOB_READ_WRITE_TOKEN / VERCEL_OIDC_TOKEN /
#   BLOB_STORE_ID are set by Vercel — do NOT copy them into this file.)
#
# OPTION B — Turso / libSQL (row-level mirroring):
#   1) Sign up with GitHub at https://turso.tech
#   2) Create a database (e.g. "aurpay") → copy its URL (libsql://….turso.io)
#   3) Create an API token (Settings → API tokens) → copy it
#   4) Add BOTH as environment variables where you deploy (Vercel:
#      Settings → Environment Variables → Production → then Redeploy)
# Verify after deploy: GET /api/health → "db": { "mode": "turso" }
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Local file database also works (no token needed):
# TURSO_DATABASE_URL=file:./db/aurpay.db
# Local test of the Blob code path without a real store (E2E cold restarts):
# URPAY_BLOB_FAKE_DIR=./db/blob-fake

# How stale the local snapshot may be before re-syncing from the shared DB
# (milliseconds). Default 15000. 0 disables periodic re-sync (mutations still
# persist immediately; login/auth still force-sync on misses).
# URPAY_SYNC_TTL_MS=15000

# Fixed login-token secret — sessions stay valid across instances & redeploys.
# Set it ONCE before sharing the site (changing it later logs everyone out).
URPAY_JWT_SECRET=change-me-to-a-long-random-string

# ── Groq (recommended) ───────────────────────────────────────────────────────
# Get free keys: https://console.groq.com/keys
# Up to 5 keys are pooled and auto-rotated on rate limits (429):
# when one key hits its limit it cools down ~1 min and the next key serves
# the request instantly — the user never waits.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
# (alternative) comma-separated list instead of numbered slots:
# GROQ_API_KEYS=key1,key2,key3

# Agent model (default: openai/gpt-oss-120b)
URPAY_AGENT_MODEL=openai/gpt-oss-120b
# Voice-to-text model (default: whisper-large-v3)
URPAY_ASR_MODEL=whisper-large-v3
# Groq-compatible base URL (default: https://api.groq.com/openai/v1)
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Optional internals (safe defaults — rarely changed) ──────────────────────
# Shared secret between the agent engine and the /api/internal/* bridge routes
URPAY_BRIDGE_SECRET=urpay-bridge-secret
# Point the LLM bridge at a remote helper instead of the local one
# (only useful for custom self-hosted setups)
# URPAY_LLM_BRIDGE=http://127.0.0.1:3000/api/internal/llm
